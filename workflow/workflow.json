      "id": "f5e38c2e-62b8-4d92-a196-a2ccc026ceb2",
      "name": "Fetch Feed",
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const activeSources = $('Get Active Sources').all().map(i => i.json);\nconst allSources = $('Get All Sources').all().map(i => i.json);\nconst fetched = $input.all();\n\nconst SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;\nconst cutoff = Date.now() - SEVEN_DAYS_MS;\n\nfunction getEntryBlocks(xml) {\n  return xml.match(/<item[\\s\\S]*?<\\/item>/g) || xml.match(/<entry[\\s\\S]*?<\\/entry>/g) || [];\n}\nfunction extractField(block, tag) {\n  const m = block.match(new RegExp(`<${tag}[^>]*>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?<\\/${tag}>`));\n  return m ? m[1].trim() : null;\n}\nfunction parseRecentEntries(xml) {\n  const blocks = getEntryBlocks(xml);\n  return blocks\n    .map(block => {\n      const title = extractField(block, 'title');\n      const dateStr = extractField(block, 'pubDate') || extractField(block, 'published') || extractField(block, 'updated');\n      const timestamp = dateStr ? Date.parse(dateStr) : NaN;\n      return { title, timestamp };\n    })\n    .filter(e => e.title && (isNaN(e.timestamp) || e.timestamp >= cutoff))\n    .sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));\n}\n\nconst updates = [];\nconst results = [];\n\nfor (let i = 0; i < activeSources.length; i++) {\n  const src = activeSources[i];\n  const xml = (fetched[i] && fetched[i].json && fetched[i].json.data) || '';\n  const recentEntries = parseRecentEntries(xml);\n  const itemCount = recentEntries.length;\n  const headlines = recentEntries.slice(0, 6).map(e => '- ' + e.title);\n\n  const newSilent = itemCount > 0 ? 0 : (src.consecutive_silent_weeks || 0) + 1;\n  let newActive = true;\n  let newMonitoring = src.monitoring;\n\n  if (itemCount === 0) {\n    if (!src.monitoring && newSilent >= 2) {\n      newMonitoring = true;\n      const nextBackup = allSources\n        .filter(s => s.pool === 'backup' && s.active === false)\n        .sort((a, b) => (a.backup_rank || 0) - (b.backup_rank || 0))[0];\n      if (nextBackup) {\n        updates.push({ json: { isUpdateRow: true, id: nextBackup.id, active: true, consecutive_silent_weeks: 0, monitoring: false, replaced_source: src.name } });\n      }\n    } else if (src.monitoring && newSilent >= 4) {\n      newActive = false;\n      newMonitoring = false;\n    }\n  } else if (src.monitoring) {\n    newMonitoring = false;\n    const replacement = allSources.find(s => s.pool === 'backup' && s.active === true && s.replaced_source === src.name);\n    if (replacement) {\n      updates.push({ json: { isUpdateRow: true, id: replacement.id, active: false, consecutive_silent_weeks: 0, monitoring: false, replaced_source: '' } });\n    }\n  }\n\n  updates.push({ json: { isUpdateRow: true, id: src.id, active: newActive, consecutive_silent_weeks: newSilent, monitoring: newMonitoring, replaced_source: src.replaced_source || '' } });\n\n  results.push({ json: { isFetchResult: true, name: src.name, itemCount, headlinesText: headlines.length ? `\\n\\n### ${src.name}\\n` + headlines.join('\\n') : `\\n\\n### ${src.name}\\n(no new articles in the last 7 days)` } });\n}\n\nreturn [...updates, ...results];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
