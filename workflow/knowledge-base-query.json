    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst articles = items\n  .map(item => item.json)\n  .filter(a => a && a.title);\n\nif (articles.length === 0) {\n  return [{ json: { count: 0, answer: \"No matching articles found.\" } }];\n}\n\nconst formatted = articles.map((a, i) =>\n  `${i+1}. [${(a.event_type || 'unknown').toUpperCase()}] ${a.title}\\n   Source: ${a.source} | Risk: ${a.threat_level}\\n   ${a.one_line}\\n   ${a.link}`\n).join('\\n\\n');\n\nreturn [{ json: {\n  count: articles.length,\n  answer: formatted\n}}];"
      },
